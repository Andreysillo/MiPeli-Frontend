# Copia este archivo como .env y pega los valores de Firebase Console →
# Configuración del proyecto → Tus apps → App web (objeto firebaseConfig).
# No son secretos (terminan dentro del bundle), pero .env no se sube a git
# para que GitHub y SonarQube no los marquen como claves filtradas.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
