{
  "name": "mipeli-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "esbuild src/main.tsx index.html --bundle --loader:.html=copy --entry-names=[name] --outdir=dist --sourcemap --servedir=dist",
